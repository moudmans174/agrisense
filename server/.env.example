PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agrisense
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173
WEATHER_MODE=live
# Optional: real Sentinel-2 statistics via Sentinel Hub (https://www.sentinel-hub.com/)
SH_CLIENT_ID=
SH_CLIENT_SECRET=
# simulated | sentinel-hub | off  (auto-refresh source used by the AI engine)
SATELLITE_AUTO=
UPLOAD_DIR=uploads
